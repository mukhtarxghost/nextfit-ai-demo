{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextfit-ai-voice",
  "main": "src/entry.py",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    "python_workers"
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "api.vantixlab.info",
      "custom_domain": true,
      "zone_name": "vantixlab.info"
    }
  ]
}